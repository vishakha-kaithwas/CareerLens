# CareerLens Environment Configuration Template

# Application
APP_NAME=CareerLens
APP_ENV=development
APP_DEBUG=true
API_V1_STR=/api/v1

# Security & CORS
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Upload & File Limits
MAX_UPLOAD_SIZE_BYTES=5242880  # 5 MB
ALLOWED_FILE_EXTENSIONS=[".pdf"]
